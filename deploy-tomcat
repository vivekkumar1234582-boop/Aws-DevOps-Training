pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/vivekkumar1234582-boop/hello-world.git'
            }
        }

        stage('Maven Clean Package') {
            steps {
                sh 'mvn clean package'

                sh '''
                    echo "WAR files generated:"
                    ls -lh webapp/target/webapp.war
                '''
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                echo 'Deploying WAR to Tomcat...'

                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'tomcat-server',

                            transfers: [
                                sshTransfer(
                                    sourceFiles: 'webapp/target/webapp.war',
                                    removePrefix: 'webapp/target',
                                    remoteDirectory: 'webapps',
                                    execCommand: '''
                                        sudo systemctl restart tomcat
                                        sleep 5
                                        sudo systemctl status tomcat --no-pager
                                    '''
                                )
                            ],

                            verbose: true
                        )
                    ]
                )
            }
        }
    }

    post {
        success {
            echo 'WAR deployment completed successfully!'
        }

        failure {
            echo 'WAR deployment failed!'
        }
    }
}
